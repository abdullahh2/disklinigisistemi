                                                i.bx.bx-trash
                                            button.btn.btn-sm.btn-outline-secondary.ms-1.print-hasta-btn(data-hasta=JSON.stringify(hasta))
                                                i.bx.bx-printer


            // MODAL HTML YAPISI (GÜNCELLENDİ)
            #editHastaModal.modal.fade(tabindex="-1" aria-labelledby="editHastaModalLabel" aria-hidden="true")
                .modal-dialog.modal-lg
                    .modal-content
                        .modal-header
                            h5#editHastaModalLabel.modal-title Hasta Bilgilerini Düzenle
                            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
                        .modal-body
                            //- YENİ: Modal içine işlem listesini göstermek için alan eklendi
                            form#editHastaForm(method="POST" action="/Admin/Hastalar/Guncelle")
                                // Gizli input, hangi hastayı güncellediğimizi bilmek için
                                input#edit-hasta-id(type="hidden" name="hastaid")

                                //- YENİ: Modal içine işlem listesini göstermek için alan eklendi
                                h6.mb-2 Seçili İşlemler
                                #edit-islem-listesi.mb-3
                                    //- Bu alan JavaScript ile doldurulacak
                                hr

                                .row.mb-3
                                    .col-md-6
                                        label(for="edit-adsoyad") Hasta Adı Soyadı
                                        input#edit-adsoyad.form-control(type="text" name="adsoyad" required)
                                    .col-md-6
                                        label(for="edit-tel") Telefon Numarası
                                        input#edit-tel.form-control(type="tel" name="tel" required)

                                .row.mb-3
                                    .col-md-6
                                        label(for="edit-doktor") Doktor Seçiniz
                                        select#edit-doktor.form-control(name="doktor" required)
                                            each doktor in doktorlar
                                                option(value=doktor._id) #{doktor.name}
                                    .col-md-6
                                        label(for="edit-randevutarih") Randevu Tarihi
                                        input#edit-randevutarih.form-control(type="datetime-local" name="randevutarih" required)

                                .row.mb-3
                                    .col-md-6
                                        label(for="edit-ucret") Toplam Ücret
                                        input#edit-ucret.form-control(type="number" name="ucret" required readonly)
                                    .col-md-6
                                        label(for="edit-odenenucret") Ödenen Miktar
                                        input#edit-odenenucret.form-control(type="number" name="odenenucret" required)

                                .mb-3
                                    label(for="edit-aciklama") Açıklama / Not
                                    textarea#edit-aciklama.form-control(name="aciklama" rows="3")

                                .modal-footer
                                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Kapat
                                    button.btn.btn-primary(type="submit") Değişiklikleri Kaydet



block csscode
    link(href="/assets/plugins/datatable/css/dataTables.bootstrap5.min.css" rel="stylesheet")
    style.
        #hastalar td {
            white-space: normal;
            word-wrap: break-word;
        }

block jscode
    script(src="/assets/plugins/datatable/js/jquery.dataTables.min.js") 
    script(src="/assets/plugins/datatable/js/dataTables.bootstrap5.min.js")
    script.
        // Tarih formatını 'YYYY-MM-DDTHH:mm' şekline çeviren yardımcı fonksiyon
        function formatISODateForInput(isoDateString) {
            if (!isoDateString) return '';
            const date = new Date(isoDateString);
            date.setMinutes(date.getMinutes() - date.getTimezoneOffset());
            return date.toISOString().slice(0, 16);
        }

        $(document).ready(function (){
            $('.hasta-sil').on('click', function () {

                var hastaId = $(this).attr('data-id');
                var url = '/Admin/Hastalar/Sil';
                var sor = confirm('Bu hastayı silmek istiyor musunuz?');
                if (sor) {
                    $.ajax({
                        url: url,
                        type: 'POST',
                        data: {
                            hastaid: hastaId
                        },
                        success: function (result) {
                            location.reload();
                        }
                    });
                }
            });

            $('#hastalar').DataTable( {
                lengthChange: false,
                language: {
                    url: "https://cdn.datatables.net/plug-ins/2.3.2/i18n/tr.json",
                },
                columnDefs: [
                    {
                        "targets": 4,
                        "render": function ( data, type, row ) {
                            var fullText = data;
                            if (type === 'display' && fullText.length > 100) {
                                return '<span class="d-inline-block text-truncate" style="max-width: 200px;" title="' + fullText + '">' + fullText + '</span>';
                            }
                            return fullText;
                        }
                    }
                ]
            });

            // YENİ EKLENEN JAVASCRIPT KODU: Modal'ı Doldurma
            $('.edit-hasta-btn').on('click', function() {
                // Tıklanan butondaki data-* attribute'lerinden verileri oku
                const hastaId = $(this).data('id');
                const adsoyad = $(this).data('adsoyad');
                const tel = $(this).data('tel');
                const doktorId = $(this).data('doktor-id');
                const randevu = $(this).data('randevu');
                const ucret = $(this).data('ucret');
                const odenen = $(this).data('odenen');
                const aciklama = $(this).data('aciklama');
                // İşlemler verisini JSON olarak oku
                const islemler = $(this).data('islemler');

                // 1. Modal içindeki standart form elemanlarını doldur
                $('#edit-hasta-id').val(hastaId);
                $('#edit-adsoyad').val(adsoyad);
                $('#edit-tel').val(tel);
                $('#edit-doktor').val(doktorId);
                $('#edit-randevutarih').val(formatISODateForInput(randevu));
                $('#edit-ucret').val(ucret);
                $('#edit-odenenucret').val(odenen);
                $('#edit-aciklama').val(aciklama);

                // 2. Modal içindeki işlem listesini doldur
                const islemListesiAlani = $('#edit-islem-listesi');
                islemListesiAlani.empty();

                if (islemler && islemler.length > 0) {
                    let islemHtml = '';
                    islemler.forEach(function(isl, index) {
                        if (isl.islem) {
                            islemHtml += `
                                <div class="row mb-2 align-items-center islem-satiri">
                                    <div class="col-md-6">
                                        <label for="islem-adet-${index}">${isl.islem.ad}</label>
                                    </div>
                                    <div class="col-md-4">
                                        <input class="form-control islem-adet-input" type="number" id="islem-adet-${index}" name="islemler[${isl.islem._id}][adet]" value="${isl.adet}" min="0" data-ucret="${isl.islem.ucret}">
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-sm btn-outline-danger remove-islem-btn" type="button">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            `;
                        } else {
                            islemHtml += '<p class="text-danger">Silinmiş bir işlem kaydı bulundu.</p>';
                        }
                    });
                    islemListesiAlani.html(islemHtml);
                } else {
                    islemListesiAlani.html('<p class="text-muted">Bu hastaya atanmış işlem bulunmamaktadır.</p>');
                }
            });

            // Fiyatı dinamik olarak güncelle
            $(document).on('input', '.islem-adet-input', function() {
                let totalUcret = 0;
                $('.islem-adet-input').each(function() {
                    const adet = parseInt($(this).val()) || 0;
                    const ucret = parseFloat($(this).data('ucret')) || 0;
                    totalUcret += adet * ucret;
                });
                $('#edit-ucret').val(totalUcret);
            });

            // İşlemi sil
            $(document).on('click', '.remove-islem-btn', function() {
                const islemSatiri = $(this).closest('.islem-satiri');
                islemSatiri.find('.islem-adet-input').val(0);
                islemSatiri.hide();
                // Fiyatı yeniden hesapla
                $('.islem-adet-input').trigger('input');
            });

            $(document).on('click', '.print-hasta-btn', function() {
                const hastaData = $(this).data('hasta');
                let printContent = `
                    <style>
                        @media print {
                            body * { visibility: hidden; }
                            #print-area, #print-area * { visibility: visible; font-family: Times New Roman; }
                            #print-area { position: absolute; left: 0; top: 0; width: 100%; }
                            table { width: 100%; border-collapse: collapse; }
                            th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
                            th { background-color: #f2f2f2; }
                            h2, h3 { text-align: center; }
                        }
                    </style>
                    <div id="print-area">


                        <div class="mb-5">
                            <h2 class="fw-bold">#{system_name}</h2>
                        </div>

                            <h4> <strong>Hasta Adı Soyadı:</strong> ${hastaData.adsoyad}</h4>
                            <table>
                                <thead>
                                    <tr>
                                        <th>İşlem</th>
                                        <th>Adet</th>
                                        <th>Birim Fiyat</th>
                                        <th>Toplam Fiyat</th>
                                    </tr>
                                </thead>
                                <tbody>
                `;

                let toplamUcret = 0;
                hastaData.islem.forEach(isl => {
                    if (isl.islem) {
                        const islemToplam = isl.adet * isl.islem.ucret;
                        toplamUcret += islemToplam;
                        printContent += `
                            <tr>
                                <td>${isl.islem.ad}</td>
                                <td>${isl.adet}</td>
                                <td>${isl.islem.ucret.toLocaleString('tr-TR')} ₺</td>
                                <td>${islemToplam.toLocaleString('tr-TR')} ₺</td>
                            </tr>
                        `;
                    }
                });

                printContent += `
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" style="text-align:right;">Genel Toplam:</th>
                            <th>${toplamUcret.toLocaleString('tr-TR')} ₺</th>
                        </tr>
                    </tfoot>
                        </table>
                        <h3>#{print_msj}</h3>
                    </div>
                `;

                $('body').append(printContent);
                window.print();
                $('#print-area').remove();
            });
        });