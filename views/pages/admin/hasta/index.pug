extends ../../../layout

block content
    .row
        .col-12.col-md-10.d-flex.mx-auto
            .card.radius-10.w-100
                .card-header
                    .d-flex.align-items-center
                        div
                            h6.mb-0 Hastalar
                        .ms-auto
                            a.btn.btn-sm.btn-outline-primary(href="/Admin/Hastalar/Ekle")
                                i.bx.bx-plus-circle.font-22
                                | Hasta Ekle

                .card-body
                    .table-responsive
                        table.table.align-middle.mb-0.table-striped.table-bordered.dataTable.nowrap-disabled#hastalar
                            thead.table-light
                                tr.text-center
                                    th #
                                    th Doktor Adı
                                    th Hasta Adı
                                    th İşlem
                                    th İşlem Açıklaması
                                    th Randevu Tarihi
                                    th Hatırlatıcı Tarihi
                                    th Telefon
                                    th Kalan Borç
                                    th İşlemler
                            tbody
