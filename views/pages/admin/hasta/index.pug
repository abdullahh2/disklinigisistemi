                                                data-tel=hasta.tel
                                                data-doktor-id=hasta.doktor._id
                                                data-randevu=hasta.randevu_tarih
                                                data-ucret=hasta.ucret
                                                data-odenen=hasta.odenen_ucret
                                                data-aciklama=hasta.aciklama
